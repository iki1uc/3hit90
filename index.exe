<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>🔮 HOLOGRAMM · 81³ · U · ZU UNS GERICHTET</title>

<style>
* { box-sizing:border-box; margin:0; padding:0; }
body {
  background: #0a0a0f;
  color: #c8d0d0;
  font-family: 'Consolas', 'Courier New', monospace;
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 12px;
  background: radial-gradient(ellipse at 50% 50%, #0a0a1a, #000000);
  transition: background 0.8s ease;
}

.container {
  max-width: 1100px;
  width: 100%;
  background: rgba(10,10,20,0.3);
  border: 1px solid rgba(0,204,255,0.05);
  border-radius: 20px;
  padding: 20px;
  backdrop-filter: blur(10px);
  box-shadow: 0 0 100px rgba(0,0,0,0.8);
}

.header {
  text-align: center;
  padding-bottom: 10px;
  border-bottom: 1px solid rgba(255,255,255,0.02);
  margin-bottom: 12px;
}
.header h1 {
  font-size: 28px;
  background: linear-gradient(90deg, #00ccff, #ff66ff, #ffaa00, #00ff88);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  letter-spacing: 4px;
}
.header .sub {
  color: #445555;
  font-size: 11px;
  letter-spacing: 3px;
}
.header .sub .u { color: #ff66ff; }
.header .sub .hologram { color: #00ff88; }

.dim-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr;
  gap: 8px;
  margin-bottom: 12px;
}
@media (max-width:700px){ .dim-grid { grid-template-columns:1fr 1fr; } }
@media (max-width:450px){ .dim-grid { grid-template-columns:1fr; } }

.dim-card {
  background: rgba(10,10,20,0.3);
  border: 1px solid rgba(255,255,255,0.02);
  border-radius: 10px;
  padding: 12px 10px;
  text-align: center;
  transition: all 0.4s ease;
}
.dim-card .icon { font-size: 28px; }
.dim-card .name {
  color: #aab;
  font-size: 12px;
  font-weight: bold;
  margin: 4px 0;
}
.dim-card .value {
  font-size: 28px;
  font-weight: bold;
  font-family: monospace;
}
.dim-card .desc {
  color: #445555;
  font-size: 8px;
  letter-spacing: 1px;
}

.holo-wrap {
  position: relative;
  width: 100%;
  max-width: 600px;
  margin: 0 auto;
  aspect-ratio: 1/1;
  background: rgba(0,0,0,0.6);
  border-radius: 16px;
  border: 1px solid rgba(255,255,255,0.02);
  overflow: hidden;
  box-shadow: inset 0 0 100px rgba(0,204,255,0.01);
}
#holoCanvas {
  width: 100%;
  height: 100%;
  display: block;
}

.controls {
  display: flex;
  gap: 4px;
  flex-wrap: wrap;
  justify-content: center;
  margin-top: 10px;
}
.controls button {
  background: rgba(20,35,35,0.2);
  color: #668888;
  border: 1px solid rgba(255,255,255,0.02);
  padding: 4px 14px;
  border-radius: 16px;
  cursor: pointer;
  font-family: inherit;
  font-size: 9px;
  transition: all 0.3s;
}
.controls button:hover { background: rgba(40,80,70,0.08); color: #aaeedd; }
.controls button.active { background: rgba(40,80,70,0.06); color: #00ff88; }
.controls button.u { color: #ff66ff; border-color: rgba(255,102,255,0.05); }
.controls button.holo { color: #00ff88; border-color: rgba(0,255,136,0.05); }

.status-bar {
  display: flex;
  justify-content: space-between;
  padding: 6px 12px;
  margin-top: 8px;
  background: rgba(0,0,0,0.2);
  border-radius: 8px;
  font-size: 8px;
  color: #445555;
  border: 1px solid rgba(255,255,255,0.01);
}
.status-bar .u { color: #ff66ff; }
.status-bar .holo { color: #00ff88; }

.footer {
  text-align: center;
  margin-top: 10px;
  color: #222;
  font-size: 8px;
  letter-spacing: 2px;
}
.footer span { color: #ff66ff; }
</style>
</head>
<body>

<div class="container" id="container">

<div class="header">
  <h1>🔮 HOLOGRAMM · 81³</h1>
  <div class="sub"><span class="u">U · ZU UNS GERICHTET</span> · <span class="hologram">81 × 81 × 81</span></div>
</div>

<div class="dim-grid">
  <div class="dim-card">
    <div class="icon">📐</div>
    <div class="name">Breite · X</div>
    <div class="value" style="color:#00ccff;">81</div>
    <div class="desc">Horizontale Ausdehnung</div>
  </div>
  <div class="dim-card">
    <div class="icon">📏</div>
    <div class="name">Höhe · Y</div>
    <div class="value" style="color:#ff66ff;">81</div>
    <div class="desc">Vertikale Ausdehnung</div>
  </div>
  <div class="dim-card">
    <div class="icon">📐</div>
    <div class="name">Tiefe · Z</div>
    <div class="value" style="color:#ffaa00;">81</div>
    <div class="desc">Räumliche Ausdehnung</div>
  </div>
  <div class="dim-card">
    <div class="icon">🌌</div>
    <div class="name">Gesamt · 81³</div>
    <div class="value" style="color:#00ff88;">531.441</div>
    <div class="desc">Vollständiger Raum</div>
  </div>
</div>

<div class="holo-wrap">
  <canvas id="holoCanvas"></canvas>
</div>

<div class="controls">
  <button class="active holo" id="btnStart">▶ START</button>
  <button class="u" id="btnU">🔮 U</button>
  <button class="holo" id="btnHolo">🌀 HOLO</button>
  <button id="btnProof">🔮 PROOF</button>
  <button id="btnReset">⟲ RESET</button>
</div>

<div class="status-bar">
  <span class="u">🔮 U: <span id="uStatus">aktiv</span></span>
  <span class="holo">🌀 81³: <span id="holoStatus">bereit</span></span>
  <span>⏱️ <span id="timeStatus">00:00</span></span>
</div>

<div class="footer">
  <span>🔮</span> HOLOGRAMM · 81³ · U · ZU UNS GERICHTET · <span>wieimmer4u</span>
</div>

</div>

<script>
// ============================================================
// HOLOGRAMM · 81³ · U · ZU UNS GERICHTET
// ============================================================

// ===== CANVAS =====
const canvas = document.getElementById('holoCanvas');
const ctx = canvas.getContext('2d');
let running = true;
let time = 0;
let uActive = true;

function resizeCanvas() {
  const rect = canvas.parentElement.getBoundingClientRect();
  const size = Math.min(rect.width, rect.height, 560);
  canvas.width = size;
  canvas.height = size;
}
window.addEventListener('resize', resizeCanvas);

// ===== HOLOGRAMM RENDER =====
function renderHologram(timestamp) {
  if (!running) return;
  time = timestamp || Date.now();
  const w = canvas.width, h = canvas.height;
  const cx = w/2, cy = h/2;
  const maxDim = Math.min(w, h);

  ctx.clearRect(0, 0, w, h);

  // Hintergrund
  const grad = ctx.createRadialGradient(cx, cy, 10, cx, cy, maxDim * 0.6);
  grad.addColorStop(0, '#0a0a1a');
  grad.addColorStop(0.5, '#050510');
  grad.addColorStop(1, '#000000');
  ctx.fillStyle = grad;
  ctx.fillRect(0, 0, w, h);

  // ===== 81 × 81 × 81 =====
  // Simuliert 81³ als 3D-Orbit
  const layers = 81;
  const pointsPerLayer = 81;
  const totalPoints = layers * pointsPerLayer;

  // Farben
  const colors = ['#00ccff', '#ff66ff', '#ffaa00', '#00ff88'];

  // 81 Tiefen-Ebenen
  for (let z = 0; z < Math.min(layers, 81); z += 3) {
    const depth = (z / layers) * 0.8 + 0.1;
    const radius = maxDim * (0.15 + depth * 0.35);
    const rotZ = time / (3000 + z * 5);
    const rotX = time / (4000 + z * 3);

    for (let i = 0; i < pointsPerLayer; i += 2) {
      const angle = (i / pointsPerLayer) * Math.PI * 2 + rotZ + z * 0.02;
      const r = radius + Math.sin(angle * 2 + rotX) * 10;

      const x = cx + Math.cos(angle) * r;
      const y = cy + Math.sin(angle) * r * 0.7 + Math.sin(z * 0.1 + time / 2000) * 20;

      const colorIdx = Math.floor((z + i) % 4);
      const alpha = 0.1 + (depth * 0.4) + Math.sin(time / 1000 + z + i) * 0.1;

      ctx.shadowColor = colors[colorIdx] + '33';
      ctx.shadowBlur = 10;
      ctx.fillStyle = colors[colorIdx] + Math.floor(alpha * 180).toString(16).padStart(2, '0');
      ctx.beginPath();
      ctx.arc(x, y, 1 + depth * 2, 0, Math.PI * 2);
      ctx.fill();
    }
  }

  // ===== DAS U – ZU UNS GERICHTET =====
  if (uActive) {
    const uSize = maxDim * 0.25;
    const uX = cx;
    const uY = cy + maxDim * 0.05;

    // U-Form als Pfad – zu uns gerichtet
    ctx.shadowColor = '#ff66ff44';
    ctx.shadowBlur = 40;
    ctx.strokeStyle = '#ff66ff88';
    ctx.lineWidth = 3 + Math.sin(time / 1000) * 1;

    ctx.beginPath();
    // Linker Schenkel
    ctx.moveTo(uX - uSize * 0.8, uY + uSize * 0.4);
    ctx.lineTo(uX - uSize * 0.8, uY - uSize * 0.4);
    // Boden
    ctx.quadraticCurveTo(uX, uY - uSize * 0.6, uX + uSize * 0.8, uY - uSize * 0.4);
    // Rechter Schenkel
    ctx.lineTo(uX + uSize * 0.8, uY + uSize * 0.4);
    ctx.stroke();

    // U-Glow
    ctx.shadowBlur = 60;
    ctx.strokeStyle = '#ff66ff22';
    ctx.lineWidth = 8;
    ctx.beginPath();
    ctx.moveTo(uX - uSize * 0.8, uY + uSize * 0.4);
    ctx.lineTo(uX - uSize * 0.8, uY - uSize * 0.4);
    ctx.quadraticCurveTo(uX, uY - uSize * 0.6, uX + uSize * 0.8, uY - uSize * 0.4);
    ctx.lineTo(uX + uSize * 0.8, uY + uSize * 0.4);
    ctx.stroke();
    ctx.shadowBlur = 0;

    // U-Text
    ctx.fillStyle = '#ff66ff66';
    ctx.font = `${maxDim * 0.025}px monospace`;
    ctx.textAlign = 'center';
    ctx.textBaseline = 'top';
    ctx.fillText('⩇ U · zu uns gerichtet ⩇', cx, uY + uSize * 0.5 + 10);
  }

  // ===== 81³ Text =====
  ctx.fillStyle = '#445555';
  ctx.font = `${maxDim * 0.02}px monospace`;
  ctx.textAlign = 'center';
  ctx.textBaseline = 'bottom';
  ctx.fillText('81 × 81 × 81 = 531.441', cx, h - 20);

  // ===== U-Status =====
  ctx.fillStyle = uActive ? '#ff66ff44' : '#44555544';
  ctx.font = `${maxDim * 0.015}px monospace`;
  ctx.textBaseline = 'top';
  ctx.fillText(uActive ? '🔮 U aktiv · zu uns gerichtet' : '🔮 U inaktiv', cx, 20);

  requestAnimationFrame(renderHologram);
}

// ===== TOGGLE U =====
function toggleU() {
  uActive = !uActive;
  document.getElementById('uStatus').textContent = uActive ? 'aktiv' : 'inaktiv';
  document.getElementById('btnU').classList.toggle('active');
  document.getElementById('btnU').textContent = uActive ? '🔮 U·ON' : '🔮 U·OFF';
  console.log(`🔮 U: ${uActive ? 'AKTIV · zu uns gerichtet' : 'INAKTIV'}`);
}

// ===== HOLO =====
function toggleHolo() {
  document.getElementById('holoStatus').textContent = '🌀 aktiv';
  document.getElementById('btnHolo').classList.toggle('active');
  setTimeout(() => {
    document.getElementById('holoStatus').textContent = 'bereit';
  }, 2000);
  console.log('🌀 HOLOGRAMM aktiviert');
}

// ===== PROOF =====
function showProof() {
  const proof = document.createElement('div');
  proof.style.cssText = `
    position: fixed; inset: 0; background: rgba(0,0,0,0.85);
    display: flex; justify-content: center; align-items: center;
    z-index: 9999; backdrop-filter: blur(20px);
    font-family: 'Consolas', monospace;
  `;
  proof.innerHTML = `
    <div style="text-align:center; padding:40px; border:1px solid rgba(255,102,255,0.1); border-radius:20px; background:rgba(10,10,20,0.6); max-width:450px;">
      <div style="font-size:48px; color:#ff66ff;">🔮</div>
      <div style="color:#ff66ff; font-size:20px; margin:12px 0; letter-spacing:4px;">HOLOGRAMM · 81³</div>
      <div style="color:#88ddbb; font-size:13px; line-height:1.8;">
        📐 Breite: 81<br>
        📏 Höhe: 81<br>
        📐 Tiefe: 81<br>
        🌌 Gesamt: 531.441<br>
        🔮 U: ${uActive ? 'AKTIV · zu uns gerichtet' : 'INAKTIV'}
      </div>
      <div style="color:#445555; font-size:10px; margin-top:12px; border-top:1px solid rgba(255,255,255,0.02); padding-top:12px;">
        DAS HOLOGRAMM IST SICHTBAR
      </div>
      <button onclick="this.parentElement.parentElement.remove()" style="
        margin-top:14px; background:rgba(20,35,35,0.2); color:#668888;
        border:1px solid rgba(255,255,255,0.02); padding:6px 20px;
        border-radius:18px; cursor:pointer; font-family:inherit; font-size:9px;
      ">⏎ SCHLIESSEN</button>
    </div>
  `;
  document.body.appendChild(proof);
}

// ===== CONTROLS =====
document.getElementById('btnStart').addEventListener('click', () => {
  running = true;
  document.getElementById('btnStart').classList.add('active');
  document.getElementById('holoStatus').textContent = 'läuft';
  renderHologram(Date.now());
});

document.getElementById('btnU').addEventListener('click', toggleU);
document.getElementById('btnHolo').addEventListener('click', toggleHolo);
document.getElementById('btnProof').addEventListener('click', showProof);

document.getElementById('btnReset').addEventListener('click', () => {
  running = false;
  uActive = true;
  document.getElementById('btnStart').classList.remove('active');
  document.getElementById('btnU').textContent = '🔮 U·ON';
  document.getElementById('btnU').classList.add('active');
  document.getElementById('uStatus').textContent = 'aktiv';
  document.getElementById('holoStatus').textContent = 'bereit';
  setTimeout(() => {
    running = true;
    document.getElementById('btnStart').classList.add('active');
    document.getElementById('holoStatus').textContent = 'läuft';
    renderHologram(Date.now());
  }, 300);
});

// ===== TASTATUR =====
document.addEventListener('keydown', (e) => {
  if (e.key === ' ') { e.preventDefault(); document.getElementById('btnStart').click(); }
  if (e.key === 'u' || e.key === 'U') document.getElementById('btnU').click();
  if (e.key === 'h' || e.key === 'H') document.getElementById('btnHolo').click();
  if (e.key === 'p' || e.key === 'P') document.getElementById('btnProof').click();
  if (e.key === 'x' || e.key === 'X') document.getElementById('btnReset').click();
});

// ===== INIT =====
resizeCanvas();
setTimeout(resizeCanvas, 200);
renderHologram(Date.now());

console.log('🔮 HOLOGRAMM · 81³ · U · ZU UNS GERICHTET');
console.log('📐 81 × 81 × 81 = 531.441');
console.log('⌨️  Leertaste=Start  u=U  h=HOLO  p=PROOF  x=Reset');
</script>

</body>
</html>
